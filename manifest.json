{
  "manifest_version": 3,
  "name": "ThongTinDoanhNghiep",
  "version": "1.0.0",
  "description": "Extract company data",
  "permissions": ["sidePanel", "scripting", "activeTab"],
  "host_permissions": [
    "https://thongtindoanhnghiep.co/*",
    "https://services-delivery-dev.intelsys.group/*"
  ],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://thongtindoanhnghiep.co/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "side_panel": { "default_path": "sidepanel.html" },
  "action": { "default_title": "ThongTinDoanhNghiep" }
}
